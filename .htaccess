# CodeIgniter 4 - Hostinger LiteSpeed Configuration
# Note: Rewrite rules not used as LiteSpeed doesn't support them
# Instead using root index.php wrapper

# Disable directory browsing
Options -Indexes

# Block direct access to sensitive folders
<FilesMatch "\.(php|phtml|php3|php4|php5|php6|php7|php8|pht|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Allow index.php in root
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>
