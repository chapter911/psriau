# CodeIgniter 4 - Redirect all requests to public folder
# This .htaccess goes in the document root (/public_html on Hostinger)
# It handles the fact that the actual web root is /public_html/public

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Don't rewrite if already in public folder
    RewriteCond %{REQUEST_URI} !^/public/
    # Don't rewrite if file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    # Don't rewrite if directory exists
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite all requests to public folder
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

# Block direct access to sensitive folders
<IfModule mod_authz_core.c>
    <DirectoryMatch "^(?!.*public).*$">
        <FilesMatch "\.(php|phtml|php3|php4|php5|php6|php7|php8|pht|phar)$">
            Deny from all
        </FilesMatch>
    </DirectoryMatch>
</IfModule>
