# CodeIgniter 4 - Redirect all requests to public folder
# This .htaccess goes in the document root (/public_html on Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Don't rewrite if already in public folder
    RewriteCond %{REQUEST_URI} !^/public/
    # Don't rewrite if file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    # Don't rewrite if directory exists
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite all requests to public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to sensitive folders via <Files>
<Files "*.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>

# Allow access to public folder
<IfModule mod_authz_core.c>
    <Directory "public">
        Require all granted
    </Directory>
</IfModule>
