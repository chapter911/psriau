{
  "openapi": "3.0.0",
  "info": {
    "title": "PSRiau API Documentation",
    "description": "Dokumentasi API untuk aplikasi PSRiau. Menggunakan mekanisme autentikasi Bearer Token untuk endpoint yang dilindungi.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Server API saat ini"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Masukkan Access Token yang Anda dapatkan setelah melakukan login."
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Operasi berhasil dilakukan."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Terjadi kesalahan atau parameter tidak valid."
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login Pengguna",
        "description": "Mengautentikasi pengguna menggunakan username dan password, serta menghasilkan token akses baru.",
        "tags": [
          "Autentikasi"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "Username pengguna",
                    "example": "pegawai.riau"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password pengguna",
                    "example": "password123"
                  },
                  "device_name": {
                    "type": "string",
                    "description": "Nama perangkat atau aplikasi klien",
                    "default": "API Token",
                    "example": "Aplikasi Mobile"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Login berhasil."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "example": "49557434a9b5f483c65c404663673c683b5840d2f0df7a4e69b2d86161474272"
                        },
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 12
                            },
                            "username": {
                              "type": "string",
                              "example": "pegawai.riau"
                            },
                            "full_name": {
                              "type": "string",
                              "example": "Agung Kesuma"
                            },
                            "role": {
                              "type": "string",
                              "example": "admin"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parameter kurang atau tidak lengkap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Username dan password wajib diisi."
                }
              }
            }
          },
          "401": {
            "description": "Kredensial login salah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Kredensial login tidak valid."
                }
              }
            }
          },
          "403": {
            "description": "Akun dinonaktifkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Akun Anda nonaktif. Hubungi administrator untuk aktivasi."
                }
              }
            }
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "summary": "Profil Pengguna",
        "description": "Mendapatkan informasi detail akun dari pengguna yang saat ini terautentikasi.",
        "tags": [
          "Autentikasi"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Informasi profil berhasil didapatkan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 12
                            },
                            "username": {
                              "type": "string",
                              "example": "pegawai.riau"
                            },
                            "full_name": {
                              "type": "string",
                              "example": "Agung Kesuma"
                            },
                            "role": {
                              "type": "string",
                              "example": "admin"
                            },
                            "is_active": {
                              "type": "integer",
                              "example": 1
                            },
                            "created_at": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-04-20 10:00:00"
                            },
                            "updated_at": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-07-08 15:30:22"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid atau tidak disediakan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Token otentikasi tidak valid."
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Keluar / Revoke Token",
        "description": "Mencabut/menghapus token akses aktif dari database sehingga tidak dapat digunakan kembali.",
        "tags": [
          "Autentikasi"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout berhasil dilakukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Logout berhasil. Token telah dicabut."
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid atau tidak disediakan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
