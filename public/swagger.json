                          "nama": {
                            "type": "string",
                            "example": "SDN 01 Pekanbaru"
                          },
                          "kabupaten": {
                            "type": "string",
                            "example": "KOTA PEKANBARU"
                          },
                          "kecamatan": {
                            "type": "string",
                            "example": "TAMPAN"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid atau tidak disediakan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
